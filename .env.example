# ============================================================
# 9Router Deployment — Example Configuration
# ============================================================
# Source: https://github.com/decolua/9router
# Docs:  https://github.com/decolua/9router#readme
# ============================================================

INITIAL_PASSWORD=__GENERATE_SECURE_PASSWORD__
JWT_SECRET=__GENERATE_SECURE_PASSWORD__
DATA_DIR=/app/data
HOSTNAME=0.0.0.0
PORT=20128
NODE_ENV=production
BASE_URL=https://router.example.com
NEXT_PUBLIC_BASE_URL=https://router.example.com
CLOUD_URL=https://9router.com
AUTH_COOKIE_SECURE=true
REQUIRE_API_KEY=true
API_KEY_SECRET=__GENERATE_SECURE_PASSWORD__
MACHINE_ID_SALT=__GENERATE_SECURE_PASSWORD__
ENABLE_REQUEST_LOGS=false
